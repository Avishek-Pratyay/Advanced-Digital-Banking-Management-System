# ---------- Database ----------
# Production / Vercel: any PostgreSQL connection string (Neon, Supabase, Vercel Postgres, RDS ...)
# Local zero-setup mode: leave DATABASE_URL empty (or set to "pglite") and the app uses an embedded
# PostgreSQL (PGlite) that stores its files in ./.data/pglite
DATABASE_URL=

# ---------- Auth ----------
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Public URL of the app (http://localhost:3000 locally, your Vercel URL in production)
NEXTAUTH_URL=http://localhost:3000

# ---------- Optional ----------
# Secret used to sign receipt verification codes (falls back to NEXTAUTH_SECRET)
RECEIPT_SECRET=
# Set to "true" to expose the seed/reset helpers in non-production environments
